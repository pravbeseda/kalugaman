---
import { Font } from 'astro:assets';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
  title: string;
  /** The page this one is a print rendering of. Its canonical, not this page's own. */
  canonicalOf: string;
}
const { lang, title, canonicalOf } = Astro.props;
const canonical = new URL(canonicalOf, Astro.site).href;
---

{
  /* A layout of its own rather than Base: the site chrome, the ClientRouter, the theme and
    the sepia palette are all things a sheet of paper does not have. What it keeps is the
    typeface, so the PDF reads like the site.

    The page is the source `page.pdf()` renders (scripts/generate-pdf.mjs) and is left
    published: it is what a browser's own Ctrl+P prints, and it is how the print layout can
    be looked at on the live site. noindex keeps it out of search, and the canonical points
    at the resume it is a rendering of — it is a duplicate with a URL, not a page of its
    own. */
}

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />
    <title>{title}</title>
    <style is:global>
      /* Print palette, not the site's: the reader palette is warm sepia, which on paper is
         a full-bleed block of colour — and, in a PDF a recruiter prints, ink. Black on
         white, and the accent only where it carries meaning. */
      :root {
        --ink: #1a1a1a;
        --ink-muted: #55534e;
        --rule: #d4d0c8;
        --accent: #8a4f2c;
        color-scheme: light;
      }

      @page {
        size: A4;
        margin: 14mm 15mm;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
      }

      body {
        font-family: var(--font-inter, system-ui, sans-serif);
        /* pt, not the site's fluid rem scale: that one is clamp(... vw), and type on paper
           must not depend on the width of a viewport that is not there. */
        font-size: 10pt;
        line-height: 1.45;
        color: var(--ink);
        background: #fff;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
        font-weight: 700;
      }

      /* A heading at the foot of a page, with its section overleaf, is the classic print
         defect. Same for a job split across the fold. */
      h2 {
        break-after: avoid;
      }
      li,
      h3 {
        break-inside: avoid;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
