---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, defaultLocale, type Locale } from '../i18n/config';
import { switchLocalePath } from '../i18n/utils';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Keep the page out of search results and out of the canonical/hreflang graph. */
  noindex?: boolean;
  /** Drop the site chrome. For pages that are not tied to one language (404). */
  bare?: boolean;
}
const { lang, title, description, noindex = false, bare = false } = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const alternates = locales.map((l) => ({
  lang: l,
  href: new URL(switchLocalePath(path, l), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      /* A noindex page has no place in the canonical/hreflang graph: it is served
        for arbitrary URLs, so those links would point nowhere meaningful. */
    }
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.lang} href={a.href} />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(switchLocalePath(path, defaultLocale), Astro.site).href}
          />
        </>
      )
    }

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    {/* SPA-like navigation (no full reload) */}
    <ClientRouter />

    {
      /* Apply theme before first paint (no FOUC); re-apply on client
        navigation via astro:after-swap, before the new document paints. */
    }
    <script is:inline>
      (() => {
        const applyTheme = () => {
          const saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        };
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <Header lang={lang} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}

    <style>
      .skip-link {
        position: absolute;
        left: -999px;
      }
      .skip-link:focus {
        left: var(--space-4);
        top: var(--space-4);
        z-index: 20;
        background: var(--color-surface);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-sm);
      }
    </style>
  </body>
</html>
