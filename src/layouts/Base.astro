---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, defaultLocale, ogLocales, type Locale } from '../i18n/config';
import { switchLocalePath, useTranslations } from '../i18n/utils';
import { ogImageUrl } from '../lib/og';
import { CARD_SIZE } from '../lib/og-card';
import { assertContentInvariants } from '../lib/content-checks';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Keep the page out of search results. Says nothing about its URL. */
  noindex?: boolean;
  /**
   * The page has no meaningful URL of its own — it is served for arbitrary paths (404).
   * Separate from `noindex`: a noindex page with a real URL (the print resume, say) still
   * wants a canonical, pointing at the page it duplicates.
   */
  noCanonical?: boolean;
  /** Drop the site chrome. For pages that are not tied to one language (404). */
  bare?: boolean;
  /** JSON-LD for the page (src/lib/schema.ts). Pages with nothing to declare pass none. */
  schema?: object | null;
}
const {
  lang,
  title,
  description,
  noindex = false,
  noCanonical = false,
  bare = false,
  schema = null,
} = Astro.props;

// Cross-document content invariants: they hold for the whole site, so the check runs
// once per build rather than in any one page.
await assertContentInvariants();

const t = useTranslations(lang);
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const alternates = locales.map((l) => ({
  lang: l,
  href: new URL(switchLocalePath(path, l), Astro.site).href,
}));

// One card per language, drawn from the resume during the build (src/lib/og-card.ts).
// The same card on every page, so its alt describes the card, not the page it is shared
// from — and it quotes the resume, because that is what the card itself is drawn from.
const ogImage = await ogImageUrl(lang, Astro.site!);
const resume = await getEntry('resume', lang);
const ogAlt = resume ? `${resume.data.name} — ${resume.data.role}` : title;

// `<` cannot survive raw inside a <script> block — it would end the tag early.
const jsonLd = schema && JSON.stringify(schema).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {
      /* Only the body weight is preloaded. A preload is a claim on bandwidth ahead of
        everything else, including the portrait that is likely the LCP; the other two
        weights are fetched right after the CSS is parsed.

        Their fallback is metric-matched at 400 and 600. Not at 700: Astro puts the
        bold-metric family after a fallback family that already covers 400 and 600, and
        font matching picks a family before it picks a weight — so a 700 request never
        reaches it (measured: 331.03px either way, against 329.52px with the bold family
        first). Headings therefore do move a little when Inter lands. */
    }
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />

    <title>{title}</title>
    <meta name="description" content={description} />

    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      !noCanonical && (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.lang} href={a.href} />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(switchLocalePath(path, defaultLocale), Astro.site).href}
          />
        </>
      )
    }

    {
      /* Open Graph. og:url is a claim about where the page lives — same claim as
      canonical, so a page without a URL of its own makes neither. */
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kalugaman.ru" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      locales
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(CARD_SIZE.width)} />
    <meta property="og:image:height" content={String(CARD_SIZE.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    {/* SPA-like navigation (no full reload) */}
    <ClientRouter />

    {
      /* Apply theme before first paint (no FOUC); re-apply on client
        navigation via astro:after-swap, before the new document paints.

        data-js rides along: it is what the theme toggle is shown behind (a button that
        switches nothing is worse than no button), and it has to be set before the first
        paint for the same reason the theme does — otherwise the button flashes in and
        out. ClientRouter swaps the attributes of <html> too, so both are re-applied. */
    }
    <script is:inline>
      (() => {
        const applyTheme = () => {
          const root = document.documentElement;
          root.setAttribute('data-js', '');
          const saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            root.setAttribute('data-theme', saved);
          }
        };
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    {/* data-i18n: the 404 is built in one language and swapped on load — see 404.astro. */}
    <a class="skip-link" href="#main" data-i18n="skip">{t('a11y.skip')}</a>
    {!bare && <Header lang={lang} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}

    <style>
      .skip-link {
        position: absolute;
        left: -999px;
      }
      .skip-link:focus {
        left: var(--space-4);
        top: var(--space-4);
        z-index: 20;
        background: var(--color-surface);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-sm);
      }
    </style>
  </body>
</html>
