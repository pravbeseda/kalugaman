---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const base = `/${lang}`;
const path = Astro.url.pathname.replace(/\/$/, '');

const links = [
  { href: `${base}`, label: t('nav.home') },
  { href: `${base}/resume`, label: t('nav.resume') },
  { href: `${base}/projects`, label: t('nav.projects') },
  { href: `${base}/contacts`, label: t('nav.contacts') },
];

const isActive = (href: string) =>
  href === base ? path === base : path.startsWith(href);
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href={base}>kalugaman<span>.ru</span></a>

    <nav class="nav" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['nav__link', { 'nav__link--active': isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <LangSwitch lang={lang} />
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.75rem;
    flex-wrap: wrap;
  }
  .brand {
    font-weight: 800;
    letter-spacing: -0.03em;
    font-size: var(--text-lg);
    color: var(--color-text);
  }
  .brand span {
    color: var(--color-muted);
  }
  .brand:hover {
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: var(--space-1);
    margin-right: auto;
    flex-wrap: wrap;
  }
  .nav__link {
    color: var(--color-muted);
    font-weight: 600;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
  }
  .nav__link:hover {
    text-decoration: none;
    color: var(--color-text);
  }
  .nav__link--active {
    color: var(--color-accent);
    background: var(--color-tag-bg);
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (max-width: 560px) {
    .nav {
      order: 3;
      width: 100%;
      justify-content: center;
    }
  }
</style>
