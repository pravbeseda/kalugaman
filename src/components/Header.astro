---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const base = `/${lang}`;
const path = Astro.url.pathname.replace(/\/$/, '');

const links = [
  { href: `${base}`, label: t('nav.home') },
  { href: `${base}/resume`, label: t('nav.resume') },
  { href: `${base}/projects`, label: t('nav.projects') },
  { href: `${base}/contacts`, label: t('nav.contacts') },
];

const isActive = (href: string) => (href === base ? path === base : path.startsWith(href));
---

<header class="header">
  <div class="container header__inner">
    {
      /* <details> rather than a button: the browser owns the open state, the keyboard and
        aria-expanded on the summary, and the menu still opens with JS off. The script
        below only handles what the element does not — Escape, a click outside, and a
        viewport that grew past the breakpoint. The links are rendered a second time
        because only one of the two navs is ever displayed, and display:none keeps the
        other out of the accessibility tree. */
    }
    <details class="menu" id="menu">
      <summary class="menu__button" aria-label={t('nav.menu')} title={t('nav.menu')}>
        <svg
          class="menu__icon menu__icon--bars"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"></path>
        </svg>
        <svg
          class="menu__icon menu__icon--close"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>

      <nav class="menu__panel" aria-label={t('nav.primary')}>
        {
          links.map((l) => (
            <a
              href={l.href}
              class:list={['nav__link', { 'nav__link--active': isActive(l.href) }]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </details>

    {
      /* The wordmark is dropped on a narrow phone (see the styles), where the row has no
        room for it — so the link is named here rather than by its text. */
    }
    <a class="brand" href={base} aria-label="kalugaman.ru">
      <Image
        src={avatar}
        alt=""
        width={32}
        densities={[1, 2]}
        class="brand__avatar"
        loading="eager"
      />
      <span class="brand__name">kalugaman<span>.ru</span></span>
    </a>

    <nav class="nav" aria-label={t('nav.primary')}>
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['nav__link', { 'nav__link--active': isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <LangSwitch lang={lang} />
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  /* Opaque, not frosted glass. At 85% the page's own text scrolling underneath dragged
     the effective background to #d8cfba, leaving the muted nav text at 3.83:1 and the
     active link at 4.19:1 — under AA, and invisible to a contrast check that assumes an
     opaque background. Keeping AA in the worst case needs 95%, where the effect is gone
     anyway; so the header simply is the page colour, which is also what the check
     asserts. */
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  /* Chrome does not print. Hidden in the component that owns it, so the rule sits at the
     same specificity as the ones it overrides rather than shouting from a global sheet. */
  @media print {
    .header {
      display: none;
    }
  }
  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.75rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-size: var(--text-lg);
    color: var(--color-text);
  }
  .brand__avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: var(--border-width) solid var(--color-border);
    flex-shrink: 0;
  }
  .brand__name span {
    color: var(--color-muted);
  }
  .brand:hover {
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: var(--space-1);
    margin-right: auto;
    flex-wrap: wrap;
  }
  .nav__link {
    color: var(--color-muted);
    font-weight: 600;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
  }
  .nav__link:hover {
    text-decoration: none;
    color: var(--color-text);
  }
  .nav__link--active {
    color: var(--color-accent);
    background: var(--color-tag-bg);
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .menu {
    display: none;
  }
  .menu__button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: var(--border-width) solid var(--color-border-control);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    /* Both rules: the marker is a ::marker in Firefox and a pseudo-element in Safari. */
    list-style: none;
  }
  .menu__button::-webkit-details-marker {
    display: none;
  }
  /* Both icons share the one grid cell, so swapping them cannot shift the button. */
  .menu__icon {
    grid-area: 1 / 1;
  }
  .menu__icon--close,
  .menu[open] .menu__icon--bars {
    display: none;
  }
  .menu[open] .menu__icon--close {
    display: block;
  }
  /* The closed panel is hidden here rather than left to the UA. Engines do hide the
     contents of a closed <details> themselves — and none of the three renders this one
     (measured in Chromium, Firefox and WebKit: no box, no hit, not focusable) — but they
     do it through machinery that a display on a direct child is one step away from
     overriding. The failure would be silent: four absolutely-positioned links hanging
     under the header for good. */
  .menu__panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2);
    background: var(--color-surface);
    border-bottom: var(--border-width) solid var(--color-border);
    box-shadow: var(--shadow);
  }
  .menu[open] .menu__panel {
    display: flex;
  }
  .menu__panel .nav__link {
    padding: var(--space-3);
  }

  /* 700px, not 560: below that the four links do fit in the row, but only by wrapping into
     two cramped lines beside the brand (measured: the header grows to 82px between 561 and
     ~660). One row of links or a burger — never a squeezed double row. The JS below closes
     the menu when the viewport grows past this width; keep the two in step. */
  @media (max-width: 700px) {
    .menu {
      display: block;
    }
    .nav {
      display: none;
    }
    .brand {
      margin-right: auto;
    }
  }

  /* On a narrow phone the row is burger + brand + language + theme, and the wordmark is
     what does not fit: at 320px the header overflowed the viewport by 47px (38px on /ru/,
     whose language switch is the shorter word). The avatar carries the link, which is
     named by the aria-label rather than by this text. */
  @media (max-width: 420px) {
    .brand__name {
      display: none;
    }
  }
</style>

<script>
  // Delegated on the document: bound once, survives ClientRouter navigation.
  // The same query the CSS shows the burger with, so there is no width that matches
  // neither (fractional widths are real: zoom, fractional DPR). Keep the two in step.
  // Held in a const, not created inline for the listener below: an unreferenced
  // MediaQueryList has been collected along with its listener in the past (WebKit), and
  // the failure that would cause — a menu that stops closing after a while — is not one
  // worth betting on a garbage collector for.
  const mobile = window.matchMedia('(max-width: 700px)');

  const openMenu = () => {
    const el = document.getElementById('menu');
    return el instanceof HTMLDetailsElement && el.open ? el : null;
  };

  // Escape closes the menu from anywhere, but the focus is only rescued when it is about
  // to disappear with the panel. Nothing traps it there — the panel is not a dialog, and
  // the page behind it is not inert — so it may well be sitting somewhere else entirely,
  // and moving it back from there would lose the reader's place.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const menu = openMenu();
    if (!menu) return;
    const hadFocus = menu.contains(document.activeElement);
    menu.open = false;
    if (hadFocus) menu.querySelector('summary')?.focus();
  });

  // Pointerdown, not click: iOS Safari does not dispatch a click that reaches the document
  // for a tap on a plain, non-clickable element, and this handler only ever runs on a
  // phone — the platform where it would silently do nothing.
  document.addEventListener('pointerdown', (e) => {
    const menu = openMenu();
    if (!menu || !(e.target instanceof Node) || menu.contains(e.target)) return;
    menu.open = false;
  });

  // A link inside the panel closes it too — but on click, not on pointerdown: closing the
  // menu takes the link out of the render tree, and the browser would never get to the
  // click that follows, so the navigation would not happen at all.
  //
  // The navigation would close the menu anyway, by swapping in a fresh <details> (the
  // router swaps even a same-URL navigation, unless the link carries a hash). But that is
  // a fact about the router, and closing the menu is the menu's own business.
  document.addEventListener('click', (e) => {
    const menu = openMenu();
    if (!menu || !(e.target instanceof Element) || !e.target.closest('.menu__panel a')) return;
    menu.open = false;
  });

  // Where the keyboard was, remembered as it happens. By the time the breakpoint fires, the
  // element that had focus is already hidden and activeElement is back to <body> — asking
  // then is too late to learn where the reader was.
  let lastInHeader: HTMLElement | null = null;
  document.addEventListener('focusin', (e) => {
    lastInHeader =
      e.target instanceof HTMLElement && e.target.closest('.nav, .menu') ? e.target : null;
  });

  // Crossing the breakpoint swaps one nav for the other, and whichever is leaving is hidden
  // with display:none — taking the keyboard position with it, though the reader never moved
  // it. (Zooming is how this is reached in earnest: it is the keyboard user who zooms.) So
  // focus is carried to the counterpart, and only when it was about to be dropped — the
  // same rule as Escape.
  mobile.addEventListener('change', (e) => {
    const menu = document.getElementById('menu');
    const nav = document.querySelector('.nav');
    const dropped = document.activeElement === document.body ? lastInHeader : null;

    if (e.matches) {
      // To the burger. Its panel is closed, so there is nowhere inside to land: the button
      // that opens it is the nearest thing to where the reader was.
      if (nav?.contains(dropped)) menu?.querySelector('summary')?.focus();
      return;
    }

    // To the full nav. Land on the same link, matched by href, rather than at the start.
    if (menu instanceof HTMLDetailsElement) menu.open = false;
    if (!menu?.contains(dropped)) return;
    const href = dropped instanceof HTMLAnchorElement ? dropped.getAttribute('href') : null;
    const twin = href && nav?.querySelector(`a[href="${href}"]`);
    if (twin instanceof HTMLElement) twin.focus();
    else nav?.querySelector('a')?.focus();
  });
</script>
