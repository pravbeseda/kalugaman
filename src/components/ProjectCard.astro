---
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
  slug: string;
  title: string;
  description: string;
  tags: string[];
  period: string;
  /** Heading level for the card title, so it follows the section it sits under: h3 below the
      projects page's group headings, h2 where the cards sit directly under a page h1. */
  titleTag?: 'h2' | 'h3';
}
const { lang, slug, title, description, tags, period, titleTag = 'h3' } = Astro.props;
const Title = titleTag;
const href = `/${lang}/projects/${slug}`;
---

<a class="project-card card" href={href}>
  <div class="project-card__head">
    <Title>{title}</Title>
    <span class="muted project-card__period">{period}</span>
  </div>
  <p class="muted">{description}</p>
  <ul class="project-card__tags">
    {tags.map((tag) => <li class="tag">{tag}</li>)}
  </ul>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    color: inherit;
    transition:
      transform var(--transition),
      border-color var(--transition);
  }
  .project-card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }
  /* The same lift the button has, so it answers the same setting the same way. Declared
     here because the rule it turns off is scoped: global.css would have to shout. */
  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }
  }
  .project-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .project-card__head :is(h2, h3) {
    font-size: var(--text-lg);
  }
  .project-card__period {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-top: auto;
    padding-top: var(--space-4);
  }
</style>
