---
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
  slug: string;
  title: string;
  description: string;
  tags: string[];
  period: string;
}
const { lang, slug, title, description, tags, period } = Astro.props;
const href = `/${lang}/projects/${slug}`;
---

<a class="project-card card" href={href}>
  <div class="project-card__head">
    <h3>{title}</h3>
    <span class="muted project-card__period">{period}</span>
  </div>
  <p class="muted">{description}</p>
  <ul class="project-card__tags">
    {tags.map((tag) => <li class="tag">{tag}</li>)}
  </ul>
</a>

<style>
  .project-card {
    display: block;
    padding: var(--space-6);
    color: inherit;
    transition: transform var(--transition), border-color var(--transition);
  }
  .project-card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }
  .project-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .project-card__head h3 {
    font-size: var(--text-lg);
  }
  .project-card__period {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
  }
</style>
