---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
---

{
  /* SVG rather than ☀/☾: Inter has no moon at all (nor does most of the Latin web),
    so a glyph would be drawn by whatever symbol font the OS happens to have — a
    different moon on every platform, next to a sun from Inter. */
}
<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label={t('theme.dark')}
  title={t('theme.toggle')}
>
  <svg
    class="theme-toggle__icon theme-toggle__sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.5"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    /* Both themes live behind @supports (see themes.css). A browser without light-dark()
       has one theme, so it gets no button promising to switch it — clicking it would do
       nothing but quietly store a choice that never shows. */
    display: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: var(--border-width) solid var(--color-border-control);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    line-height: 1;
  }
  @supports (color: light-dark(#000, #fff)) {
    /* Hidden until the script that gives the button its behaviour has run, and revealed by
       that script itself (data-theme-ready) — not by an inline script elsewhere, which
       would only prove that *some* JS ran: a module that never executes (a dropped chunk,
       a CSP that allows inline and blocks the bundle) would leave the button visible and
       inert, which is the thing this gate exists to prevent.

       visibility, not display: the button keeps its 2.25rem of the row from the first
       paint, so appearing cannot shove the language switch sideways. Where there is no JS
       at all, that leaves an empty slot — cheaper than a header that jumps. */
    .theme-toggle {
      display: inline-grid;
      visibility: hidden;
    }
    :global(:root[data-theme-ready]) .theme-toggle {
      visibility: visible;
    }
  }
  /* Both icons share the one grid cell, so swapping them cannot shift the layout. */
  .theme-toggle__icon {
    grid-area: 1 / 1;
  }
  .theme-toggle__moon {
    display: none;
  }

  /* The icon names the theme in force. Without an explicit choice that is the system's,
     which the attribute cannot tell us — hence the media query. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .theme-toggle__sun {
      display: none;
    }
    :global(:root:not([data-theme])) .theme-toggle__moon {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .theme-toggle__sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle__moon {
    display: block;
  }
  :global(:root[data-theme='light']) .theme-toggle__sun {
    display: block;
  }
  :global(:root[data-theme='light']) .theme-toggle__moon {
    display: none;
  }
</style>

<script>
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

  const isDark = () => {
    const chosen = document.documentElement.getAttribute('data-theme');
    return chosen === 'dark' || (!chosen && systemDark.matches);
  };

  // The icon names the theme in force; so must the button, for a reader who does not see
  // it. Hence a toggle button named after the dark theme, pressed when that theme is on —
  // rather than a button named after the act of switching, whose "pressed" would say
  // nothing about which theme that left us in.
  //
  // Written by script and not rendered: at build time the theme is whatever the visitor's
  // system says, so any attribute we shipped would be a guess, and a wrong one for anyone
  // whose system prefers dark. The gap that leaves is between parsing this button and
  // running this module, which is deferred — hence the call below, not just the listeners.
  const syncPressed = () => {
    document.getElementById('theme-toggle')?.setAttribute('aria-pressed', String(isDark()));
    // Reveals the button (see the styles). Set from here, because this module is what makes
    // the button do anything; a flag set anywhere else would only say that some other JS ran.
    document.documentElement.setAttribute('data-theme-ready', '');
  };

  // Delegated handler on the document: bound once, works from first paint
  // (no astro:page-load gap) and survives ClientRouter navigation.
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element) || !e.target.closest('#theme-toggle')) {
      return;
    }
    const next = isDark() ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    syncPressed();
  });

  syncPressed();

  // A navigation swaps in a button without the attribute, and takes data-theme-ready off
  // <html> with the rest of its attributes; astro:after-swap runs before the new document
  // paints, so neither the state nor the button itself flickers. (astro:page-load would be
  // too late for the button — it fires after that paint.) A system that flips theme under a
  // visitor who never chose one changes the answer without touching the button at all.
  document.addEventListener('astro:after-swap', syncPressed);
  systemDark.addEventListener('change', syncPressed);
</script>
