---
import { useTranslations, switchLocalePath } from '../i18n/utils';
import { type Locale } from '../i18n/config';
const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const other: Locale = lang === 'en' ? 'ru' : 'en';
const target = switchLocalePath(Astro.url.pathname, other);
---

<a class="lang-switch" href={target} hreflang={other} lang={other}>
  {t('lang.switch')}
</a>

<style>
  .lang-switch {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-muted);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--color-border-control);
  }
  .lang-switch:hover {
    text-decoration: none;
    color: var(--color-text);
    border-color: var(--color-accent);
  }
</style>
