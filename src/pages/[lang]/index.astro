---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.png';
import Base from '../../layouts/Base.astro';
import { locales, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
import { personSchema } from '../../lib/schema';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const home = await getEntry('pages', `${lang}/home`);
if (!home) throw new Error(`Missing home page for ${lang}`);
const { Content } = await render(home);

// Single source for the name: read it from the resume of the same locale
const resume = await getEntry('resume', lang);
const displayName = resume?.data.name ?? 'kalugaman';
const currentJob = resume?.data.experience.find((job) => job.current);

const contacts = await getEntry('pages', `${lang}/contacts`);
const schema =
  resume && contacts
    ? personSchema({
        lang,
        site: Astro.site!,
        resume: resume.data,
        contacts: contacts.data,
        home: home.data,
        image: portrait.src,
      })
    : null;
---

<Base lang={lang} title={home.data.title} description={home.data.description} schema={schema}>
  <section class="hero section">
    <div class="container home__col">
      <div class="hero__intro">
        <Image
          src={portrait}
          alt={displayName}
          width={128}
          densities={[1, 2]}
          class="hero__avatar"
          loading="eager"
        />
        <div class="hero__heading">
          <h1 class="hero__name">{displayName}</h1>
          {
            currentJob && (
              <p class="hero__role">
                <span class="hero__role-position">{currentJob.position}</span>
                <span class="hero__role-sep">{' · '}</span>
                <span class="hero__role-company">{currentJob.company}</span>
              </p>
            )
          }
        </div>
      </div>
      {home.data.tagline && <p class="hero__tagline">{home.data.tagline}</p>}
      <div class="prose hero__body">
        <Content />
      </div>
      <div class="hero__cta">
        <a class="button button--primary" href={`/${lang}/projects`}>
          {t('home.cta.projects')}
        </a>
        <a class="button" href={`/${lang}/resume`}>{t('home.cta.resume')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-8);
  }
  /* single centered column for the whole home page, like /resume and /contacts */
  .home__col {
    max-width: 46rem;
  }
  .hero__intro {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .hero__avatar {
    width: 104px;
    height: 104px;
    object-fit: cover;
    /* bias the crop toward the top so there's headroom above the head */
    object-position: 50% 18%;
    border-radius: 50%;
    border: var(--border-width) solid var(--color-border);
    flex-shrink: 0;
  }
  .hero__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }
  .hero__name {
    font-size: var(--step-fluid-h2);
    line-height: 1.1;
  }
  /* flex-wrap keeps the company as one unit: when it doesn't fit beside the
     position it drops to its own line, and only breaks by words on the very
     narrowest screens instead of overflowing the viewport. */
  .hero__role {
    display: flex;
    flex-wrap: wrap;
    color: var(--color-muted);
    font-size: var(--text-lg);
  }
  .hero__tagline {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }
  .hero__body {
    max-width: 46rem;
    font-size: var(--text-lg);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  /* On phones the avatar stacks above the name so the heading gets the full
     width — enough room for the company name to sit on its own line intact. */
  @media (max-width: 420px) {
    .hero__intro {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero__role {
      font-size: var(--text-base);
    }
  }
</style>
