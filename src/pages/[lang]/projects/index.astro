---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { locales, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const projects = (await getCollection('projects'))
  .filter((p) => p.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.order - b.data.order);

// Commercial work first: it is what a recruiter scans for. A group with no entries
// renders nothing, heading included.
const groups = (['commercial', 'personal'] as const)
  .map((kind) => ({ kind, items: projects.filter((p) => p.data.kind === kind) }))
  .filter((group) => group.items.length > 0);
---

<Base
  lang={lang}
  title={`${t('nav.projects')} · kalugaman`}
  description={t('projects.description')}
>
  <section class="section">
    <div class="container">
      <h1>{t('projects.all')}</h1>
      {
        groups.map((group) => (
          <section class="group">
            <h2>{t(`projects.${group.kind}`)}</h2>
            <div class="grid">
              {group.items.map((p) => (
                <ProjectCard
                  lang={lang}
                  slug={p.id.replace(`${lang}/`, '')}
                  title={p.data.title}
                  description={p.data.description}
                  tags={p.data.tags}
                  period={p.data.period}
                  titleTag="h3"
                />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .group {
    margin-top: var(--space-8);
  }
  /* A quiet divider label, not a second page title: at h2 defaults it would compete
     with the h1 right above it. */
  .group > h2 {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    margin-top: var(--space-4);
  }
</style>
