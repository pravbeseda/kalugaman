---
import { getEntry, render } from 'astro:content';
import Print from '../../../layouts/Print.astro';
import { locales, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const resume = await getEntry('resume', lang);
if (!resume) throw new Error(`Missing resume for ${lang}`);
const { Content } = await render(resume);
const { name, role, location, experience, skills, education, languages } = resume.data;

// Contacts live with the contacts page, not in the resume: the same single source the
// JSON-LD Person is built from (src/lib/schema.ts). A CV without them is unusable, and a
// second copy of an email is a second thing to forget.
const contacts = await getEntry('pages', `${lang}/contacts`);
if (!contacts) throw new Error(`Missing contacts for ${lang}`);
const { email, socials = [] } = contacts.data;

// The URL is what a reader retypes off paper, so it is the URL that is printed — not a
// label hiding it behind a hyperlink that a sheet of paper cannot follow.
const bare = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<Print lang={lang} title={`${name} — ${role}`} canonicalOf={`/${lang}/resume`}>
  <header class="head">
    <div>
      <h1>{name}</h1>
      <p class="role">{role}</p>
    </div>
    <ul class="contacts">
      <li>{location}</li>
      <li><a href={`mailto:${email}`}>{email}</a></li>
      {
        socials.map((s) => (
          <li>
            <a href={s.url}>{bare(s.url)}</a>
          </li>
        ))
      }
    </ul>
  </header>

  <div class="summary">
    <Content />
  </div>

  <section>
    <h2>{t('resume.experience')}</h2>
    {
      experience.map((job) => (
        <article class="job">
          <div class="job__meta">
            <h3>
              {job.position} · <span class="company">{job.company}</span>
            </h3>
            <span class="period">{job.period}</span>
          </div>
          <ul class="highlights">
            {job.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section>
    <h2>{t('resume.skills')}</h2>
    <ul class="skills">
      {
        skills.map((group) => (
          <li>
            <span class="skills__group">{group.group}</span>
            <span>{group.items.join(' · ')}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="two-col">
    <section>
      <h2>{t('resume.education')}</h2>
      {
        education.map((e) => (
          <div class="entry">
            <h3>{e.degree}</h3>
            <div class="muted">{e.place}</div>
            <div class="period">{e.period}</div>
          </div>
        ))
      }
    </section>

    <section>
      <h2>{t('resume.languages')}</h2>
      <ul class="langs">
        {
          languages.map((l) => (
            <li>
              <span>{l.name}</span>
              <span class="muted">{l.level}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Print>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12mm;
    padding-bottom: 3mm;
    border-bottom: 1px solid var(--rule);
  }
  h1 {
    font-size: 20pt;
    letter-spacing: -0.02em;
  }
  .role {
    font-size: 11pt;
    font-weight: 600;
    color: var(--accent);
  }
  .contacts {
    list-style: none;
    padding: 0;
    text-align: right;
    font-size: 9pt;
    color: var(--ink-muted);
  }
  .contacts a {
    color: var(--accent);
  }

  .summary {
    margin-top: 4mm;
    color: var(--ink-muted);
  }

  section {
    margin-top: 6mm;
  }
  h2 {
    font-size: 11pt;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    padding-bottom: 1mm;
    margin-bottom: 3mm;
    border-bottom: 1px solid var(--rule);
  }
  h3 {
    font-size: 10pt;
  }

  /* Keep a job whole where it fits on one page; a two-line orphan under a heading at the
     foot of a sheet is the thing this is for. Jobs longer than a page break normally —
     forbidding that outright would leave a blank half-page. */
  .job {
    break-inside: avoid;
  }
  .job + .job {
    margin-top: 4mm;
  }
  .job__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 6mm;
  }
  .company {
    font-weight: 400;
    color: var(--ink-muted);
  }
  .period {
    font-size: 9pt;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .highlights {
    margin-top: 1mm;
    padding-left: 5mm;
  }
  .highlights li {
    margin-top: 0.5mm;
  }

  .skills {
    list-style: none;
    padding: 0;
  }
  .skills li {
    display: grid;
    grid-template-columns: 32mm 1fr;
    gap: 4mm;
    padding-block: 1mm;
  }
  .skills li + li {
    border-top: 1px solid var(--rule);
  }
  .skills__group {
    font-weight: 600;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10mm;
  }
  .entry + .entry {
    margin-top: 3mm;
  }
  .muted {
    color: var(--ink-muted);
  }

  .langs {
    list-style: none;
    padding: 0;
  }
  .langs li {
    display: flex;
    justify-content: space-between;
    padding-block: 1mm;
  }
  .langs li + li {
    border-top: 1px solid var(--rule);
  }
</style>
