---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../../../assets/portrait.png';
import Base from '../../../layouts/Base.astro';
import { locales, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/utils';
import { personSchema } from '../../../lib/schema';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const resume = await getEntry('resume', lang);
if (!resume) throw new Error(`Missing resume for ${lang}`);
const { Content } = await render(resume);
const { name, role, location, experience, skills, education, languages } = resume.data;

const description = `${role}, ${location}`;

// Contacts render on the page and in the printed CV, and they are the same single source
// the JSON-LD Person is built from. A resume with no way to reach its author is unusable —
// on paper especially — so a missing contact file or email fails the build rather than
// printing `mailto:undefined` into a PDF someone downloads.
const contacts = await getEntry('pages', `${lang}/contacts`);
if (!contacts) throw new Error(`Missing contacts for ${lang}`);
const { email, socials = [] } = contacts.data;
if (!email) throw new Error(`Missing email in contacts for ${lang}`);

// The URL is printed, not hidden behind a label: on paper a hyperlink cannot be followed,
// so what is shown has to be the thing a reader retypes.
const bare = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');

// The header carries only direct-contact channels — email and messaging — so it does not
// open with a wall of links. Profiles (GitHub, LinkedIn) move to the foot of the CV; they
// still reach the reader, just not before the name. Split by host, so a channel added to
// contacts.md later defaults to the foot rather than crowding the top. (This is display
// only: the JSON-LD Person still lists every social in `sameAs`, from the same source.)
const DIRECT_HOSTS = new Set(['t.me']);
const host = (url: string) => new URL(url).host;
const directSocials = socials.filter((s) => DIRECT_HOSTS.has(host(s.url)));
const profileSocials = socials.filter((s) => !DIRECT_HOSTS.has(host(s.url)));

// The Person node is the same on every page of a language, so it takes its
// description from the home page — the one place that describes the person.
const home = await getEntry('pages', `${lang}/home`);
const schema = home
  ? personSchema({
      lang,
      site: Astro.site!,
      resume: resume.data,
      contacts: contacts.data,
      home: home.data,
      image: portrait.src,
    })
  : null;
---

<Base lang={lang} title={`${name} — ${role}`} description={description} schema={schema}>
  <section class="section">
    <div class="container narrow">
      <header class="head">
        <div class="head__identity">
          <Image
            src={portrait}
            alt={name}
            width={160}
            densities={[1, 2]}
            class="portrait"
            loading="eager"
          />
          <div>
            <h1>{name}</h1>
            <p class="role">{role}</p>
            <p class="muted">{location}</p>
            <ul class="contacts">
              <li><a href={`mailto:${email}`}>{email}</a></li>
              {
                directSocials.map((s) => (
                  <li>
                    <a href={s.url}>{bare(s.url)}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        {/* The button is for the screen — on paper it prints as a dead link to itself. */}
        <a class="button download" href={`/cv/cv-${lang}.pdf`}>{t('resume.download')}</a>
      </header>

      <div class="prose summary">
        <Content />
      </div>

      <h2>{t('resume.experience')}</h2>
      <div class="stack timeline">
        {
          experience.map((job) => (
            <div class="job">
              <div class="job__head">
                <div class="job__title">
                  <strong>{job.position}</strong>
                  <span class="muted job__company">{job.company}</span>
                </div>
                <span class="job__period">{job.period}</span>
              </div>
              <ul>
                {job.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <h2>{t('resume.skills')}</h2>
      <div class="skills">
        {
          skills.map((group) => (
            <div class="skills__group">
              <h3>{group.group}</h3>
              <ul class="tags">
                {group.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="two-col">
        <div>
          <h2>{t('resume.education')}</h2>
          <div class="stack">
            {
              education.map((e) => (
                <div>
                  <strong>{e.degree}</strong>
                  <div class="muted">{e.place}</div>
                  <div class="muted period">{e.period}</div>
                </div>
              ))
            }
          </div>
        </div>
        <div>
          <h2>{t('resume.languages')}</h2>
          <ul class="langs">
            {
              languages.map((l) => (
                <li>
                  <span>{l.name}</span>
                  <span class="muted">{l.level}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {
        profileSocials.length > 0 && (
          <ul class="profiles">
            {profileSocials.map((s) => (
              <li>
                <a href={s.url}>{bare(s.url)}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 48rem;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }
  .head__identity {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .portrait {
    width: 88px;
    height: 108px;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius);
    border: var(--border-width) solid var(--color-border);
    flex-shrink: 0;
  }
  .role {
    font-size: var(--text-lg);
    color: var(--color-accent);
    font-weight: 600;
  }
  .contacts {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
  }
  .contacts a {
    color: var(--color-accent);
  }
  .summary {
    margin-bottom: var(--space-12);
  }
  h2 {
    margin-top: var(--space-12);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .timeline {
    margin-top: var(--space-6);
  }
  /* Position and company on the left, the period pinned top-right as a pill. The period is
     kept out of the title's flow entirely, so it never wraps into the position/company line
     the way a shared inline run did — its place is fixed regardless of how long they are. */
  .job__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .job__company {
    display: block;
    margin-top: var(--space-1);
  }
  /* Same pill as .tag (global.css) — kept on the same spacing/type tokens so the two do not
     drift apart. The extra properties here are layout only: it sits in a flex row, must not
     shrink, and its date must not wrap. */
  .job__period {
    flex-shrink: 0;
    margin-top: 3px;
    padding: 2px var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: nowrap;
    color: var(--color-tag-text);
    background: var(--color-tag-bg);
    border-radius: 999px;
  }
  /* On a narrow screen the pill drops under the title instead of squeezing it. */
  @media (max-width: 560px) {
    .job__head {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
  .period {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .job ul {
    padding-left: var(--space-6);
  }
  .job + .job {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
  }
  .skills {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    margin-top: var(--space-6);
  }
  .skills__group h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-3);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }
  .two-col {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
  }
  .langs {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
  }
  .langs li {
    display: flex;
    justify-content: space-between;
    padding-block: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  /* Profiles at the foot: the links that are not direct contact, kept off the top. A rule
     above sets them apart from the last section without shouting a heading for two URLs. */
  .profiles {
    list-style: none;
    padding: var(--space-4) 0 0;
    margin-top: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
  }
  .profiles a {
    color: var(--color-accent);
  }

  /* The page's screen padding is wasted margin on paper, and the fluid h1 is sized for a
     viewport that is not there, so it is pinned. (The download button is a dead link to the
     very file being printed — but it is a .button, hidden with the rest of them in
     global.css, not here.) Fitting the CV to a page count is deferred until the content
     settles (see the roadmap) — this is only what a readable sheet needs. */
  @media print {
    .section {
      padding-block: 0;
    }
    .head {
      margin-bottom: var(--space-6);
    }
    h1 {
      font-size: 22pt;
    }
    /* A section heading stranded at the foot of a page, its content overleaf, is the
       classic print defect; a job split across the fold is the same thing one level down.
       A job longer than a page still breaks — forbidding that outright leaves a blank
       half-page — but the ones that fit stay whole. */
    h2 {
      margin-top: var(--space-8);
      break-after: avoid;
    }
    .job,
    .skills__group {
      break-inside: avoid;
    }
    /* --font-mono is a system stack with no Cyrillic guarantee, and the PDF ships from a
       runner whose fonts we do not control. Anything monospace that can hold Cyrillic must
       therefore render in the self-hosted Inter in print, so every glyph in the file comes
       from an embedded font rather than the build machine: the dates (Russian months —
       \"март 2013\") and the skill tags (one of which is \"Unit-тесты\"). Verified by
       inspecting the fonts the PDF actually embeds — with this off, both fell to a system
       monospace. */
    .period,
    .job__period,
    .tag {
      font-family: var(--font-sans);
    }
  }
</style>
